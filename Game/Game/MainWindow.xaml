<Window x:Class="Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Het Mysterie van de Avondschool" 
        Height="680" 
        Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="#151C30"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown" 
        KeyUp="Window_KeyUp">

    <Window.Resources>
        <!-- Pixelart lettertype -->
        <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Font/#Press Start 2P</FontFamily>
        <!-- Nieuwe groene neonknoppen -->
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Background" Value="#1F5125"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Groene gloed -->
                            <Border Margin="2" Background="#39FF14" CornerRadius="5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#39FF14" BlurRadius="13" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                            </Border>

                            <!-- Felgroene buitenrand -->
                            <Border Margin="2" Background="#39FF14" CornerRadius="5"/>

                            <!-- Donkergroene binnenkant -->
                            <Border x:Name="InnerButton" Margin="6" Background="{TemplateBinding Background}" CornerRadius="3"/>

                            <!-- Tekst van de knop -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>

                        <!-- Interactieve effecten -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InnerButton" Property="Background" Value="#2D7532"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InnerButton" Property="Background" Value="#143F1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ========================================== -->
        <!-- 1. DE GAME CANVAS (Verborgen bij opstarten)-->
        <!-- ========================================== -->
        <ScrollViewer x:Name="GameScrollViewer" 
                      Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Hidden" 
                      VerticalScrollBarVisibility="Hidden" 
                      CanContentScroll="True"
                      Focusable="False">
            <Canvas x:Name="GameCanvas" Background="#1E1E24" Focusable="True" />
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- 2. QUIZ OVERLAY (Verborgen bij opstarten)  -->
        <!-- ========================================== -->
        <Grid x:Name="QuizOverlay" Visibility="Collapsed" Background="#AA000000">
            <Border Background="#2D2D3A" CornerRadius="12" Width="380" Height="230" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    BorderBrush="#FFD700" BorderThickness="2">
                <StackPanel Margin="20">
                    <TextBlock Text="🔒 Deur Vergrendeld" Foreground="#FFD700" 
                               FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock x:Name="QuizQuestionText" Text="Los de som op:" Foreground="White" 
                               FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <TextBox x:Name="QuizAnswerInput" Width="140" Height="34" FontSize="16" 
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                             KeyDown="QuizAnswerInput_KeyDown"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Openen" Width="110" Height="32" Click="SubmitAnswer_Click" 
                                Background="#4CAF50" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                        <Button Content="Annuleren" Width="90" Height="32" Click="CancelQuiz_Click" 
                                Background="#F44336" Foreground="White"/>
                    </StackPanel>

                    <TextBlock x:Name="QuizFeedbackText" Foreground="#FF5252" 
                               FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 3. START MENU (Zichtbaar bij opstarten)    -->
        <!-- ========================================== -->
        <Grid x:Name="StartMenuOverlay" Visibility="Visible">

            <!-- Pixelart achtergrond -->
            <Image Source="pack://application:,,,/Assets/menu.png"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!-- Titel in het gele vak -->
            <TextBlock Text="Het mysterie van de avondschool"
                       FontFamily="{StaticResource PixelFont}"
                       FontSize="13"
                       Foreground="Black"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,48,0,0"/>

            <!-- Hoofdmenu -->
            <StackPanel x:Name="MainMenu"
                        Width="375"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- Startknop -->
                <Button Content="Start de game"
                        Style="{StaticResource NeonButton}"
                        Height="55"
                        Margin="0,0,0,45"
                        Click="Button_Click"/>

                <!-- Instellingen -->
                <Button Content="Instellingen"
                        Style="{StaticResource NeonButton}"
                        Height="55"
                        Margin="0,0,0,45"/>

                <!-- Afsluiten -->
                <Button Content="Spel afsluiten"
                        Style="{StaticResource NeonButton}"
                        Height="55"
                        Click="Afsluiten_Click"/>
            </StackPanel>
        </Grid>

    </Grid>
</Window>